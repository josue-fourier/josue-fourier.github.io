# PostgreSQL Database Credentials
POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_DB="default_database"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432

# Django Core Settings
SECRET_KEY="django-insecure-s@hb%%4L9NjXoDH3YW8bX&yz*Rrv%6"
DEBUG=True

# The URL slug for Django's admin endpoint (e.g. "admin/" or custom secret path)
ADMIN_URL="admin/"

# Cloudflare Tunnel Token (optional, used in docker-compose.yml)
CLOUDFLARE_TOKEN=""

# Telemetry & Edge Node Integration (Raspberry Pi heartbeats)
TELEMETRY_TOKEN="super-secret-telemetry-token-change-me"

# Image API write access (upload/edit/delete via /api/images/...). Send as
# "Authorization: Bearer <token>" or "X-API-Token: <token>". Unset = writes disabled
# (logged-in staff users can still write).
IMAGE_API_TOKEN=""

# NTFY Status Ingestion Integration
# - For Docker network container: "https://ntfy" or "http://ntfy"
# - For public/remote server: "https://ntfy.sh" or "https://ntfy.yourdomain.com"
NTFY_URL=""
NTFY_TOPIC=""
NTFY_TOKEN="" # Optional bearer token if topic is protected
# Set to 'false' if connecting to an internal container over HTTPS with a self-signed or domain certificate
NTFY_VERIFY_SSL=true
# Cache window to poll from ntfy (defaults to 'all' for all cached messages; or 'latest', '1h', etc.)
NTFY_SINCE="all"

# HackerRank Badge Ingestion API (defaults to public endpoint if omitted)
# HACKERRANK_BADGES_URL="https://www.hackerrank.com/rest/hackers/xmenmagnet/badges"

# Huey Task Queue (defaults to SqliteHuey; set HUEY_IMMEDIATE=False to use worker daemon)
# HUEY_CLASS="huey.SqliteHuey"
# HUEY_FILENAME="/app/huey_data/huey.sqlite3"
# HUEY_IMMEDIATE=True
